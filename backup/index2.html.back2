<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Policia de Tierra del Fuego - Licencia Medica</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="styles.css">
</head>

<body>
    <div class="bg-atm"></div>
    <div class="toast-c" id="toastC"></div>

    <div class="mod-ov" id="modOk">
        <div class="mod-bx">
            <div class="si"><i class="fas fa-check"></i></div>
            <h2>Solicitud Registrada</h2>
            <p>La licencia fue ingresada al sistema.</p>
            <div class="tr-num" id="trNum">LM-2025-00001</div>
            <p style="font-size:.75rem;margin-top:4px">Se notificará automáticamente al jefe de dependencia.</p>
            <button class="btn-p" onclick="resetApp()" style="width:100%;justify-content:center;margin-top:16px"><i
                    class="fas fa-plus"></i> Nueva Solicitud</button>
        </div>
    </div>

    <!-- ═══ MODAL LOGIN ═══ -->
    <div class="login-ov" id="modLogin">
        <div class="login-card">
            <div class="login-badge">
                <img src="img/escudo_oro.png" alt="Escudo Policía TDF">
            </div>
            <h2 style="font-size:1.3rem;font-weight:700;margin-bottom:4px">Acceso al Sistema</h2>
            <p style="font-size:0.8rem;color:var(--fg-muted);margin-bottom:20px">Policía de Tierra del Fuego</p>

            <form onsubmit="doLogin(event)" style="display:flex;flex-direction:column;gap:14px">
                <div class="fg" style="text-align:left">
                    <label>Número de Legajo <span class="rq">*</span></label>
                    <input type="text" id="loginLeg" placeholder="Ej: 12345" maxlength="8" inputmode="numeric" required>
                </div>
                <div class="fg" style="text-align:left">
                    <label>Contraseña <span class="rq">*</span></label>
                    <input type="password" id="loginPass" placeholder="••••••••" required>
                </div>
                <button type="submit" class="btn-p" style="width:100%;justify-content:center;margin-top:6px">
                    <i class="fas fa-right-to-bracket"></i> Iniciar Sesión
                </button>
            </form>

            <div class="divider" style="margin:18px 0 14px"></div>

            <button class="btn-s" onclick="demoLogin()" style="width:100%;justify-content:center;font-size:0.8rem">
                <i class="fas fa-bolt" style="color:var(--gold)"></i> Acceso Rápido Demo (Legajo 12345)
            </button>
            <button onclick="closeLoginModal()"
                style="background:transparent;border:none;color:var(--fg-muted);font-size:0.75rem;margin-top:12px;cursor:pointer">
                Continuar sin iniciar sesión
            </button>
        </div>
    </div>

    <!-- ═══ MODAL CAMBIAR CONTRASEÑA ═══ -->
    <div class="mod-ov" id="modPassword">
        <div class="mod-bx">
            <div class="mod-head">
                <h3><i class="fas fa-key" style="color:var(--gold)"></i> Cambiar Contraseña</h3>
                <button class="mod-close" onclick="closePasswordModal()"><i class="fas fa-times"></i></button>
            </div>
            <form onsubmit="savePassword(event)" style="display:flex;flex-direction:column;gap:12px;text-align:left">
                <div class="fg">
                    <label>Contraseña Actual <span class="rq">*</span></label>
                    <input type="password" id="pwCurr" required placeholder="••••••••">
                </div>
                <div class="fg">
                    <label>Nueva Contraseña <span class="rq">*</span></label>
                    <input type="password" id="pwNew" required placeholder="Mínimo 6 caracteres">
                </div>
                <div class="fg">
                    <label>Confirmar Nueva Contraseña <span class="rq">*</span></label>
                    <input type="password" id="pwConf" required placeholder="Repetir contraseña">
                </div>
                <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:8px">
                    <button type="button" class="btn-s" onclick="closePasswordModal()">Cancelar</button>
                    <button type="submit" class="btn-p"><i class="fas fa-check"></i> Actualizar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ═══ MODAL MIS SOLICITUDES ═══ -->
    <div class="mod-ov" id="modRequests">
        <div class="mod-bx mod-lg">
            <div class="mod-head">
                <h3><i class="fas fa-folder-open" style="color:var(--gold)"></i> Mis Solicitudes de Licencia</h3>
                <button class="mod-close" onclick="closeMyRequestsModal()"><i class="fas fa-times"></i></button>
            </div>
            <p style="font-size:0.8rem;color:var(--fg-muted)">Historial de licencias tramitadas por tu legajo.</p>
            <div class="req-list" id="reqListContainer">
                <!-- Se puebla dinámicamente -->
            </div>
            <div style="display:flex;justify-content:flex-end;margin-top:16px">
                <button class="btn-s" onclick="closeMyRequestsModal()">Cerrar</button>
            </div>
        </div>
    </div>

    <div class="app">
        <header class="hdr">
            <!-- Izquierda: Escudo Policial -->
            <div class="hdr-left">
                <div class="hdr-shield">
                    <img src="img/escudo_oro.png" alt="Policía de Tierra del Fuego" class="shield-img">
                </div>
            </div>

            <!-- Centro: Título Licencia Médica -->
            <div class="hdr-center">
                <h1 class="hdr-title">Licencia Médica</h1>
            </div>

            <!-- Derecha: Botón de Usuario / Iniciar Sesión -->
            <div class="hdr-right">
                <div class="user-top-bar">
                    <button class="user-btn" id="btnUserMenu" onclick="toggleUserDropdown()" aria-label="Menú de Usuario">
                        <div class="user-avatar" id="hdrUserAvatar"><i class="fas fa-user"></i></div>
                        <div class="user-info-text">
                            <span class="user-name" id="hdrUserName">Iniciar Sesión</span>
                            <span class="user-leg" id="hdrUserLeg">Acceso por Legajo</span>
                        </div>
                        <i class="fas fa-chevron-down user-arrow"></i>
                    </button>
                    <div class="user-dropdown" id="userDropdown">
                        <div class="ud-header">
                            <div class="ud-name" id="udName">Sin sesión activa</div>
                            <div class="ud-leg" id="udLeg">Ingresá tu legajo</div>
                        </div>
                        <div id="udMenuLogged" style="display:none">
                            <button class="ud-item" onclick="openPasswordModal()"><i class="fas fa-key"></i> Cambiar
                                Contraseña</button>
                            <button class="ud-item" onclick="openMyRequestsModal()"><i class="fas fa-folder-open"></i> Mis
                                Solicitudes</button>
                            <div class="ud-divider"></div>
                            <button class="ud-item logout" onclick="doLogout()"><i class="fas fa-right-from-bracket"></i>
                                Cerrar Sesión</button>
                        </div>
                        <div id="udMenuGuest">
                            <button class="ud-item" onclick="openLoginModal()"><i class="fas fa-right-to-bracket"></i>
                                Iniciar Sesión</button>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Barra progreso mobile -->
        <div class="prog-bar" id="progBar">
            <div class="prog-top">
                <span class="prog-step" id="pS"><i class="fas fa-clipboard-list"></i> Tipo de Solicitud</span>
                <span class="prog-total" id="pT">1 / 6</span>
            </div>
            <div class="prog-track">
                <div class="prog-fill" id="pF" style="width:16.66%"></div>
            </div>
        </div>

        <!-- Stepper desktop -->
        <nav class="stepper" id="stepper" aria-label="Pasos">
            <div class="st-i act" data-step="1">
                <div class="st-c">1</div><span class="st-l">Tipo</span>
            </div>
            <div class="st-ln" data-line="1"></div>
            <div class="st-i" data-step="2">
                <div class="st-c">2</div><span class="st-l">Personal</span>
            </div>
            <div class="st-ln" data-line="2" id="lnTer"></div>
            <div class="st-i" data-step="3" id="sTer">
                <div class="st-c">3</div><span class="st-l">Tercero</span>
            </div>
            <div class="st-ln" data-line="3"></div>
            <div class="st-i" data-step="4">
                <div class="st-c">4</div><span class="st-l">Detalle</span>
            </div>
            <div class="st-ln" data-line="4"></div>
            <div class="st-i" data-step="5">
                <div class="st-c">5</div><span class="st-l">Docs</span>
            </div>
            <div class="st-ln" data-line="5"></div>
            <div class="st-i" data-step="6">
                <div class="st-c">6</div><span class="st-l">Resumen</span>
            </div>
        </nav>

        <!-- ═══ PASO 1 ═══ -->
        <section class="panel act" id="p1">
            <div class="card">
                <h2 class="card-t">Tipo de Solicitud</h2>
                <p class="card-s">Definí el alcance y naturaleza</p>
                <div class="fg">
                    <label>Motivo de la Licencia <span class="rq">*</span></label>
                    <select id="sMotivo" onchange="onMotivoChange()">
                        <option value="">Seleccionar motivo</option>
                        <option value="Enfermedad comun">Enfermedad común</option>
                        <option value="Por enfermedad o accidente de largo tratamiento, vinculado al servicio">Por
                            enfermedad o accidente de largo tratamiento, vinculado al servicio</option>
                        <option value="Por enfermedad o accidente de largo tratamiento, desvinculado al servicio">Por
                            enfermedad o accidente de largo tratamiento, desvinculado al servicio</option>
                        <option value="Atencion familiar">Atención familiar</option>
                        <option value="Donacion de sangre">Donación de sangre</option>
                        <option value="Maternidad">Maternidad</option>
                        <option value="Por lactancia">Por lactancia</option>
                        <option value="Para donar organos">Para donar órganos</option>
                        <option value="Licencia pandemia">Licencia pandemia</option>
                        <option value="Dto. 564/18 lic. extraordinaria">Dto. 564/18 lic. extraordinaria</option>
                        <option value="Dto. 564/18 lic. extraordinaria ley 911-art 9">Dto. 564/18 lic. extraordinaria
                            ley 911-art 9</option>
                        <option value="Art">Art</option>
                        <option value="Fallecimiento">Fallecimiento</option>
                    </select>
                    <span class="em" id="eMotivo"><i class="fas fa-exclamation-circle"></i> Seleccioná un motivo</span>
                </div>
                <div class="divider"></div>
                <div class="sec-lbl">Naturaleza</div>
                <div class="rc-g">
                    <div class="rc sel" id="rcN" onclick="setNat('nueva')" tabindex="0" role="radio"
                        aria-checked="true">
                        <div class="rc-i"><i class="fas fa-file-medical"></i></div>
                        <h4>Nueva</h4>
                        <p>Primera del episodio</p>
                    </div>
                    <div class="rc" id="rcP" onclick="setNat('prolongacion')" tabindex="0" role="radio"
                        aria-checked="false">
                        <div class="rc-i"><i class="fas fa-file-circle-plus"></i></div>
                        <h4>Prolongación</h4>
                        <p>Extensión vigente</p>
                    </div>
                </div>
                <div class="cond" id="cProl">
                    <div class="fg"><label>Nro. Licencia Anterior <span class="rq">*</span></label><input type="text"
                            id="nroLicAnt" placeholder="Ej: LM-2025-00123"><span class="em" id="eNroL"><i
                                class="fas fa-exclamation-circle"></i> Ingresá el número</span></div>
                </div>
            </div>
            <div class="nav-btns">
                <div class="spacer"></div><button class="btn-p" onclick="next(1)">Siguiente <i
                        class="fas fa-arrow-right"></i></button>
            </div>
        </section>

        <!-- ═══ PASO 2 ═══ -->
        <section class="panel" id="p2">
            <div class="card">
                <h2 class="card-t">Datos del Personal</h2>
                <p class="card-s">Información del efectivo policial</p>
                <div class="fgrid">
                    <div class="locked-info-banner">
                        <i class="fas fa-user-lock"></i>
                        <div>
                            <strong>Datos Institucionales Oficiales</strong>
                            <p>Los datos del personal provienen del Legajo Policial y no pueden modificarse.</p>
                        </div>
                    </div>
                    <div class="fg"><label>Legajo <i class="fas fa-lock"
                                style="color:var(--blue);font-size:0.7rem;margin-left:4px"
                                title="Dato oficial no modificable"></i> <span class="rq">*</span></label><input
                            type="text" id="sLeg" placeholder="Ej: 12345" maxlength="8" inputmode="numeric" readonly
                            tabindex="-1"><span class="em" id="eLeg"><i class="fas fa-exclamation-circle"></i>
                            Requerido</span></div>
                    <div class="fg"><label>Jerarquía <i class="fas fa-lock"
                                style="color:var(--blue);font-size:0.7rem;margin-left:4px"
                                title="Dato oficial no modificable"></i> <span class="rq">*</span></label><select
                            id="sGra" disabled>
                            <option value="">Seleccionar</option>

                            <option>Comisario General</option>
                            <option>Comisario Inspector</option>
                            <option>Comisario</option>
                            <option>Subcomisario</option>
                            <option>Principal</option>
                            <option>Inspector</option>
                            <option>Subinspector</option>
                            <option>Ayudante</option>
                            <option>Suboficial Mayor</option>
                            <option>Sargento 1ro</option>
                            <option>Sargento</option>
                            <option>Cabo 1ro</option>
                            <option>Cabo</option>
                            <option>Agente</option>
                            <option>PC Auxiliar Sup 1º</option>
                            <option>PC Auxiliar Sup 2º</option>
                            <option>PC Auxiliar Sup 3º</option>
                            <option>PC Auxiliar Sup 4º</option>
                            <option>PC Auxiliar Sup 5º</option>
                            <option>PC Auxiliar Sup 6º</option>
                            <option>PC Auxiliar Sup 7º</option>
                            <option>PC Auxiliar Sup 8º</option>
                            <option>PC Auxiliar 1º</option>
                            <option>PC Auxiliar 2º</option>
                            <option>PC Auxiliar 3º</option>
                            <option>PC Auxiliar 4º</option>
                            <option>PC Auxiliar 5º</option>
                            <option>PC Auxiliar 6º</option>
                            <option>PC Auxiliar 7º</option>
                            <option>PC Auxiliar 8º</option>
                        </select><span class="em" id="eGra"><i class="fas fa-exclamation-circle"></i> Requerido</span>
                    </div>
                    <div class="fg"><label>DNI <i class="fas fa-lock"
                                style="color:var(--blue);font-size:0.7rem;margin-left:4px"
                                title="Dato oficial no modificable"></i> <span class="rq">*</span></label><input
                            type="text" id="sDni" placeholder="Ej: 35123456" maxlength="10" inputmode="numeric" readonly
                            tabindex="-1"><span class="em" id="eDni"><i class="fas fa-exclamation-circle"></i>
                            Requerido</span></div>
                    <div class="fg"><label>CUIL / CUIT <i class="fas fa-lock"
                                style="color:var(--blue);font-size:0.7rem;margin-left:4px"
                                title="Dato oficial no modificable"></i></label><input type="text" id="sCui"
                            placeholder="Ej: 20-35123456-8" readonly tabindex="-1"></div>
                    <div class="fg full"><label>Apellido y Nombres <i class="fas fa-lock"
                                style="color:var(--blue);font-size:0.7rem;margin-left:4px"
                                title="Dato oficial no modificable"></i> <span class="rq">*</span></label><input
                            type="text" id="sNom" placeholder="Apellido, Nombres" autocomplete="name" readonly
                            tabindex="-1"><span class="em" id="eNom"><i class="fas fa-exclamation-circle"></i>
                            Requerido</span></div>
                    <div class="fg"><label>Fecha de Nacimiento <i class="fas fa-lock"
                                style="color:var(--blue);font-size:0.7rem;margin-left:4px"
                                title="Dato oficial no modificable"></i> <span class="rq">*</span></label><input
                            type="date" id="sFN" readonly tabindex="-1"><span class="em" id="eFN"><i
                                class="fas fa-exclamation-circle"></i>
                            Requerido</span></div>
                    <div class="fg"><label>Género <i class="fas fa-lock"
                                style="color:var(--blue);font-size:0.7rem;margin-left:4px"
                                title="Dato oficial no modificable"></i></label><select id="sGen" disabled>
                            <option value="">Seleccionar</option>
                            <option value="F">Femenino</option>
                            <option value="M">Masculino</option>
                            <option value="X">No binario</option>
                            <option value="NP">Prefiero no decir</option>
                        </select></div>
                    <div class="fg"><label>Teléfono <i class="fas fa-lock"
                                style="color:var(--blue);font-size:0.7rem;margin-left:4px"
                                title="Dato oficial no modificable"></i> <span class="rq">*</span></label><input
                            type="tel" id="sTel" placeholder="Ej: 2901 555-1234" inputmode="tel" autocomplete="tel"
                            readonly tabindex="-1"><span class="em" id="eTel"><i class="fas fa-exclamation-circle"></i>
                            Requerido</span></div>
                    <div class="fg"><label>Email <i class="fas fa-lock"
                                style="color:var(--blue);font-size:0.7rem;margin-left:4px"
                                title="Dato oficial no modificable"></i> <span class="rq">*</span></label><input
                            type="email" id="sEma" placeholder="correo@ejemplo.com" inputmode="email"
                            autocomplete="email" readonly tabindex="-1"><span class="em" id="eEma"><i
                                class="fas fa-exclamation-circle"></i> Requerido</span></div>
                    <div class="fg full"><label>Domicilio Real Constituido <i class="fas fa-lock"
                                style="color:var(--blue);font-size:0.7rem;margin-left:4px"
                                title="Dato oficial no modificable"></i> <span class="rq">*</span></label><input
                            type="text" id="sDir" placeholder="Calle, número, piso, depto" autocomplete="street-address"
                            readonly tabindex="-1"><span class="em" id="eDir"><i class="fas fa-exclamation-circle"></i>
                            Requerido</span></div>
                    <div class="fg full"><label>Lugar de Usufructo <span class="rq">*</span> <span class="rq"
                                style="font-weight:normal;font-size:0.75rem;color:var(--txt-s)">(Dirección constituida
                                para la licencia)</span></label><input type="text" id="sUsu"
                            placeholder="Calle, número, piso, depto donde cumplirá la licencia"><span class="em"
                            id="eUsu"><i class="fas fa-exclamation-circle"></i> Requerido</span></div>
                    <div class="fg"><label>Localidad</label><input type="text" id="sLoc" placeholder="Ej: Ushuaia">
                    </div>
                    <div class="fg"><label>Código Postal</label><input type="text" id="sCP" placeholder="Ej: V9410"
                            maxlength="10"></div>
                    <div class="fg full"><label>Obra Social <span class="rq">*</span></label><input type="text" id="sOS"
                            placeholder="Ej: OSPF, Osde, PAMI..."><span class="em" id="eOS"><i
                                class="fas fa-exclamation-circle"></i> Requerido</span></div>
                    <div class="fg"><label>Nro. Afiliado</label><input type="text" id="sNAf" placeholder="Ej: 12345678">
                    </div>
                </div>
                <div class="divider"></div>
                <div class="fg" style="margin-bottom:0">
                    <label><i class="fas fa-building-shield"
                            style="color:var(--gold);margin-right:3px;font-size:.75rem"></i> Dependencia <span
                            class="rq">*</span></label>
                    <select id="sDep" onchange="onDep()">
                        <option value="">Seleccionar dependencia</option>
                    </select>
                    <span class="em" id="eDep"><i class="fas fa-exclamation-circle"></i> Requerido</span>
                    <div class="jefe-box" id="jBox" style="display:none">
                        <div class="jb-i"><i class="fas fa-user-tie"></i></div>
                        <div class="jb-n">
                            <div class="jb-lb">Jefe a notificar</div>
                            <div class="jb-nm" id="jNm">-</div>
                            <div class="jb-dp" id="jDp">-</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="nav-btns"><button class="btn-s" onclick="prev(2)"><i class="fas fa-arrow-left"></i>
                    Anterior</button><button class="btn-p" onclick="next(2)">Siguiente <i
                        class="fas fa-arrow-right"></i></button></div>
        </section>

        <!-- ═══ PASO 3 ═══ -->
        <section class="panel" id="p3">
            <div class="card">
                <h2 class="card-t">Datos del Tercero</h2>
                <p class="card-s">Persona a quien asistís</p>
                <div class="fg"><label>Vínculo <span class="rq">*</span></label><select id="tVin">
                        <option value="">Seleccionar</option>
                        <option>Hijo/a</option>
                        <option>Esposo/a</option>
                        <option>Concubino/a</option>
                        <option>Padre</option>
                        <option>Madre</option>
                        <option>Hermano/a</option>
                        <option>Suegro/a</option>
                        <option>Nuera/Yerno</option>
                        <option>Otro</option>
                    </select><span class="em" id="eTV"><i class="fas fa-exclamation-circle"></i> Seleccioná</span></div>
                <div class="fg"><label>Nombre Completo <span class="rq">*</span></label><input type="text" id="tNom"
                        placeholder="Apellido, Nombres"><span class="em" id="eTN"><i
                            class="fas fa-exclamation-circle"></i> Requerido</span></div>
                <div class="fg"><label>DNI <span class="rq">*</span></label><input type="text" id="tDni"
                        placeholder="Ej: 35123456" maxlength="10" inputmode="numeric"><span class="em" id="eTD"><i
                            class="fas fa-exclamation-circle"></i> Requerido</span></div>
                <div class="fg"><label>Fecha de Nacimiento</label><input type="date" id="tFN"></div>
                <div class="fg"><label>Obra Social del Tercero</label><input type="text" id="tOS"
                        placeholder="Ej: PAMI"></div>
                <div class="fg"><label>Nro. Afiliado</label><input type="text" id="tNAf" placeholder="Ej: 12345678">
                </div>
                <div class="fg"><label>Diagnóstico <span class="rq">*</span></label><textarea id="tDiag"
                        placeholder="Motivo por el cual se necesita atender al tercero" rows="3"></textarea><span
                        class="em" id="eTDi"><i class="fas fa-exclamation-circle"></i> Requerido</span></div>
            </div>
            <div class="nav-btns"><button class="btn-s" onclick="prev(3)"><i class="fas fa-arrow-left"></i>
                    Anterior</button><button class="btn-p" onclick="next(3)">Siguiente <i
                        class="fas fa-arrow-right"></i></button></div>
        </section>

        <!-- ═══ PASO 4 ═══ -->
        <section class="panel" id="p4">
            <div class="card">
                <h2 class="card-t">Detalle de la Licencia</h2>
                <p class="card-s">Información clínica y períodos</p>
                <div class="fgrid">
                    <div class="fg"><label>Fecha Desde <span class="rq">*</span></label><input type="date"
                            id="lDes"><span class="em" id="eDes"><i class="fas fa-exclamation-circle"></i>
                            Requerido</span></div>
                    <div class="fg"><label>Fecha Hasta <span class="rq">*</span></label><input type="date"
                            id="lHas"><span class="em" id="eHas"><i class="fas fa-exclamation-circle"></i>
                            Requerido</span></div>
                    <div class="fg full"><label>Diagnóstico <span class="rq">*</span></label><input type="text"
                            id="lCie" placeholder="Ej: J06.9 - Infección aguda vías respiratorias"><span class="em"
                            id="eCie"><i class="fas fa-exclamation-circle"></i> Requerido</span></div>
                    <div class="fg full"><label>Descripción Diagnóstico</label><textarea id="lDiD"
                            placeholder="Detalle adicional (opcional)" rows="2"></textarea></div>
                    <div class="fg full"><label>Médico Tratante</label><input type="text"
                            id="lMed" placeholder="Apellido y nombre"></div>
                    <div class="fg"><label>Especialidad</label><select id="lEsp" onchange="onEspChange()">
                            <option value="">Seleccionar</option>
                            <option>Cardiología</option>
                            <option>Cirugía General</option>
                            <option>Clínica Médica</option>
                            <option>Dermatología</option>
                            <option>Endocrinología</option>
                            <option>Gastroenterología</option>
                            <option>Ginecología</option>
                            <option>Guardia Médica</option>
                            <option>Neumonología</option>
                            <option>Neurología</option>
                            <option>Obstetricia</option>
                            <option>Oftalmología</option>
                            <option>Oncología</option>
                            <option>Otorrinolaringología</option>
                            <option>Pediatría</option>
                            <option>Psiquiatría</option>
                            <option>Traumatología</option>
                            <option>Urología</option>
                            <option>Otra</option>
                        </select>
                    </div>
                    <div class="fg cond full" id="cEspOtra">
                        <label>Especificar Especialidad <span class="rq">*</span></label>
                        <input type="text" id="lEspOtra" placeholder="Ingresá la especialidad médica">
                        <span class="em" id="eEspOtra"><i class="fas fa-exclamation-circle"></i> Requerido al seleccionar 'Otra'</span>
                    </div>
                    <div class="fg"><label>Matrícula</label><input type="text" id="lMat" placeholder="Ej: MN 12345">
                    </div>
                    <div class="fg"><label>Institución</label><input type="text" id="lIns"
                            placeholder="Hospital, clínica..."></div>
                    <div class="fg"><label>Tel. Médico</label><input type="tel" id="lTM" placeholder="Ej: 2901 555-1234"
                            inputmode="tel"></div>
                </div>
                <div class="divider"></div>
                <div class="chk" id="chkI" onclick="togI()" tabindex="0" role="checkbox" aria-checked="false">
                    <div class="ck-b"><i class="fas fa-check"></i></div>
                    <span><i class="fas fa-hospital" style="color:var(--danger);margin-right:3px;font-size:.8rem"></i>
                        Requiere internación</span>
                </div>
                <div class="cond" id="cInt">
                    <div class="fgrid">
                        <div class="fg"><label>Fecha Ingreso</label><input type="date" id="lFI"></div>
                        <div class="fg"><label>Sala / Piso</label><input type="text" id="lSal"
                                placeholder="Ej: Piso 3, Sala 12"></div>
                    </div>
                </div>
            </div>
            <div class="nav-btns"><button class="btn-s" onclick="prev(4)"><i class="fas fa-arrow-left"></i>
                    Anterior</button><button class="btn-p" onclick="next(4)">Siguiente <i
                        class="fas fa-arrow-right"></i></button></div>
        </section>

        <!-- ═══ PASO 5 ═══ -->
        <section class="panel" id="p5">
            <div class="card">
                <h2 class="card-t">Documentación</h2>
                <p class="card-s">Subí certificados y estudios</p>
                <div class="um">
                    <div>
                        <div class="us-t"><i class="fas fa-file-medical-alt"></i> Certificado Médico (obligatorio)</div>
                        <div class="uz" id="zC" onclick="document.getElementById('fC').click()"
                            ondragover="dO(event,'zC')" ondragleave="dL(event,'zC')" ondrop="dD(event,'cert')"><input
                                type="file" id="fC" accept=".pdf,.jpg,.jpeg,.png" onchange="fS(event,'cert')" multiple>
                            <div class="uz-i"><i class="fas fa-cloud-upload-alt"></i></div>
                            <h4>Tocá para seleccionar</h4>
                            <p>PDF, JPG o PNG. Máx 10MB.</p>
                        </div>
                        <div class="fl-l" id="lC"></div>
                    </div>
                    <div class="divider"></div>
                    <div>
                        <div class="us-t"><i class="fas fa-microscope"></i> Estudios Complementarios</div>
                        <div class="uz" id="zE" onclick="document.getElementById('fE').click()"
                            ondragover="dO(event,'zE')" ondragleave="dL(event,'zE')" ondrop="dD(event,'est')"><input
                                type="file" id="fE" accept=".pdf,.jpg,.jpeg,.png" onchange="fS(event,'est')" multiple>
                            <div class="uz-i"><i class="fas fa-cloud-upload-alt"></i></div>
                            <h4>Tocá para seleccionar</h4>
                            <p>Análisis, radiografías, etc.</p>
                        </div>
                        <div class="fl-l" id="lE"></div>
                    </div>
                    <div class="divider"></div>
                    <div>
                        <div class="us-t"><i class="fas fa-prescription-bottle-medical"></i> Receta u Orden Médica</div>
                        <div class="uz" id="zR" onclick="document.getElementById('fR').click()"
                            ondragover="dO(event,'zR')" ondragleave="dL(event,'zR')" ondrop="dD(event,'rec')"><input
                                type="file" id="fR" accept=".pdf,.jpg,.jpeg,.png" onchange="fS(event,'rec')" multiple>
                            <div class="uz-i"><i class="fas fa-cloud-upload-alt"></i></div>
                            <h4>Tocá para seleccionar</h4>
                            <p>Receta, orden, derivación.</p>
                        </div>
                        <div class="fl-l" id="lR"></div>
                    </div>
                </div>
            </div>
            <div class="nav-btns"><button class="btn-s" onclick="prev(5)"><i class="fas fa-arrow-left"></i>
                    Anterior</button><button class="btn-p" onclick="next(5)">Siguiente <i
                        class="fas fa-arrow-right"></i></button></div>
        </section>

        <!-- ═══ PASO 6 ═══ -->
