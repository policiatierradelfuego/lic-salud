        function toggleUserDropdown() {
            const dropdown = document.getElementById('userDropdown');
            const btn = document.getElementById('btnUserMenu');
            dropdown.classList.toggle('show');
            btn.classList.toggle('active');
        }

        document.addEventListener('click', (e) => {
            const bar = document.querySelector('.user-top-bar');
            if (bar && !bar.contains(e.target)) {
                document.getElementById('userDropdown')?.classList.remove('show');
                document.getElementById('btnUserMenu')?.classList.remove('active');
            }
        });

        function openLoginModal() {
            document.getElementById('modLogin').classList.add('vis');
            document.getElementById('userDropdown').classList.remove('show');
        }

        function closeLoginModal() {
            document.getElementById('modLogin').classList.remove('vis');
        }

        function doLogin(e) {
            e.preventDefault();
            const leg = document.getElementById('loginLeg').value.trim();
            if (!leg) {
                toast('Ingresá tu número de legajo', 'er');
                return;
            }

            let user = MOCK_USERS[leg];
            if (!user) {
                user = {
                    legajo: leg,
                    grado: "Agente",
                    nombre: `Oficial (Legajo ${leg})`,
                    dni: `${leg}000`,
                    cuil: `20-${leg}000-9`,
                    fechaNac: "1990-01-01",
                    telefono: "2901 555-0000",
                    email: `legajo${leg}@policiatdf.gob.ar`,
                    domicilio: "Domicilio Registrado",
                    usufructo: "Domicilio Registrado",
                    obraSocial: "OSPF",
                    nroAfiliado: "100200",
                    dependenciaId: 1
                };
            }

            setSession(user);
            closeLoginModal();
            toast(`Bienvenido/a, ${user.nombre}`, 'ok');
        }

        function demoLogin() {
            document.getElementById('loginLeg').value = "12345";
            document.getElementById('loginPass').value = "123456";
            doLogin(new Event('submit'));
        }

        function setSession(user) {
            CURRENT_USER = user;
            updateUserHeaderUI();
            fillPersonalDataFromUser();
        }

        function doLogout() {
            CURRENT_USER = null;
            updateUserHeaderUI();
            document.getElementById('userDropdown').classList.remove('show');
            toast('Sesión cerrada correctamente', 'in');
        }

        function updateUserHeaderUI() {
            const btnAvatar = document.getElementById('hdrUserAvatar');
            const hdrName = document.getElementById('hdrUserName');
            const hdrLeg = document.getElementById('hdrUserLeg');
            const udName = document.getElementById('udName');
            const udLeg = document.getElementById('udLeg');
            const menuLogged = document.getElementById('udMenuLogged');
            const menuGuest = document.getElementById('udMenuGuest');

            if (CURRENT_USER) {
                hdrName.textContent = CURRENT_USER.nombre;
                hdrLeg.textContent = `Legajo: ${CURRENT_USER.legajo}`;
                udName.textContent = CURRENT_USER.nombre;
                udLeg.textContent = `${CURRENT_USER.grado} — Legajo ${CURRENT_USER.legajo}`;
                btnAvatar.innerHTML = `<i class="fas fa-user-check"></i>`;
                menuLogged.style.display = 'block';
                menuGuest.style.display = 'none';
            } else {
                hdrName.textContent = 'Iniciar Sesión';
                hdrLeg.textContent = 'Acceso por Legajo';
                udName.textContent = 'Sin sesión activa';
                udLeg.textContent = 'Ingresá tu legajo';
                btnAvatar.innerHTML = `<i class="fas fa-user"></i>`;
                menuLogged.style.display = 'none';
                menuGuest.style.display = 'block';
            }
        }

        function fillPersonalDataFromUser() {
            if (!CURRENT_USER) return;
            const setVal = (id, val) => {
                const el = document.getElementById(id);
                if (el && val) el.value = val;
            };

            setVal('sLeg', CURRENT_USER.legajo);
            setVal('sGra', CURRENT_USER.grado);
            setVal('sDni', CURRENT_USER.dni);
            setVal('sCui', CURRENT_USER.cuil);
            setVal('sNom', CURRENT_USER.nombre);
            setVal('sFN', CURRENT_USER.fechaNac);
            setVal('sTel', CURRENT_USER.telefono);
            setVal('sEma', CURRENT_USER.email);
            setVal('sDir', CURRENT_USER.domicilio);
            setVal('sUsu', CURRENT_USER.usufructo);
            setVal('sOS', CURRENT_USER.obraSocial);
            setVal('sNAf', CURRENT_USER.nroAfiliado);
            if (CURRENT_USER.dependenciaId) {
                const sDep = document.getElementById('sDep');
                if (sDep) {
                    sDep.value = CURRENT_USER.dependenciaId;
                    onDep();
                }
            }
        }


        /* ═══ MODAL CONTRASEÑA ═══ */
        function openPasswordModal() {
            if (!CURRENT_USER) {
                openLoginModal();
                return;
            }
            document.getElementById('userDropdown').classList.remove('show');
            document.getElementById('pwCurr').value = '';
            document.getElementById('pwNew').value = '';
            document.getElementById('pwConf').value = '';
            document.getElementById('modPassword').classList.add('vis');
        }

        function closePasswordModal() {
            document.getElementById('modPassword').classList.remove('vis');
        }

        function savePassword(e) {
            e.preventDefault();
            const pNew = document.getElementById('pwNew').value;
            const pConf = document.getElementById('pwConf').value;

            if (pNew.length < 6) {
                toast('La contraseña debe tener al menos 6 caracteres', 'er');
                return;
            }
            if (pNew !== pConf) {
                toast('Las contraseñas no coinciden', 'er');
                return;
            }
            closePasswordModal();
            toast('Contraseña modificada correctamente', 'ok');
        }

        /* ═══ MODAL MIS SOLICITUDES ═══ */
        function openMyRequestsModal() {
            if (!CURRENT_USER) {
                openLoginModal();
                return;
            }
            document.getElementById('userDropdown').classList.remove('show');
            const container = document.getElementById('reqListContainer');
            container.innerHTML = `
                <div class="req-item">
                    <div>
                        <div class="req-id">LM-2025-00123</div>
                        <div class="req-sub">Enfermedad común • 5 días</div>
                    </div>
                    <span class="badge gn"><i class="fas fa-check"></i> Aprobada</span>
                </div>
                <div class="req-item">
                    <div>
                        <div class="req-id">LM-2025-00456</div>
                        <div class="req-sub">Atención familiar • 3 días</div>
                    </div>
                    <span class="badge am"><i class="fas fa-clock"></i> En revisión</span>
                </div>
            `;
            document.getElementById('modRequests').classList.add('vis');
        }

        function closeMyRequestsModal() {
            document.getElementById('modRequests').classList.remove('vis');
        }

        /* ═══ ESTADO ═══ */
        const S = { cur: 1, tipo: 'propia', motivo: '', nat: 'nueva', intern: false, jefe: null, arch: { cert: [], est: [], rec: [] } };
        const SL = { 1: { i: 'fa-clipboard-list', l: 'Tipo de Solicitud' }, 2: { i: 'fa-id-badge', l: 'Datos del Personal' }, 3: { i: 'fa-people-arrows', l: 'Datos del Tercero' }, 4: { i: 'fa-notes-medical', l: 'Detalle de la Licencia' }, 5: { i: 'fa-paperclip', l: 'Documentacion' }, 6: { i: 'fa-check-double', l: 'Resumen y Envio' } };
        /* ═══ INIT ═══ */
        (async function () {
            const s = document.getElementById('sDep');

            const renderDeps = () => {
                s.innerHTML = '<option value="">Seleccionar dependencia</option>';
                DEPS.forEach(d => {
                    const o = document.createElement('option');
                    o.value = d.id;
                    o.textContent = d.nombre;
                    s.appendChild(o);
                });
            };

            try {
                const res = await fetch('dependencias.json');
                if (res.ok) {
                    DEPS = await res.json();
                    console.log('Dependencias cargadas dinámicamente.');
                }
            } catch (err) {
                console.warn('No se pudo cargar dependencias.json de forma dinámica (usando fallback local):', err);
            }

            renderDeps();
            updateUserHeaderUI();
            updVis();
            updBot();
        })();

        /* ═══ PASO 1 ═══ */
        function onMotivoChange() { const m = document.getElementById('sMotivo').value; S.motivo = m; S.tipo = (m === 'Atencion familiar') ? 'atendible' : 'propia'; updVis(); }
        function onEspChange() { const v = document.getElementById('lEsp').value; const c = document.getElementById('cEspOtra'); if (v === 'Otra') { c.classList.add('vis'); } else { c.classList.remove('vis'); document.getElementById('lEspOtra').value = ''; } }
        function setTipo(t) { S.tipo = t; updVis(); }
        function setNat(n) { S.nat = n; document.getElementById('rcN').classList.toggle('sel', n === 'nueva'); document.getElementById('rcP').classList.toggle('sel', n === 'prolongacion'); document.getElementById('rcN').setAttribute('aria-checked', n === 'nueva'); document.getElementById('rcP').setAttribute('aria-checked', n === 'prolongacion'); const c = document.getElementById('cProl'); if (n === 'prolongacion') c.classList.add('vis'); else { c.classList.remove('vis'); document.getElementById('nroLicAnt').value = ''; } }
        function togI() { S.intern = !S.intern; const e = document.getElementById('chkI'); e.classList.toggle('ck', S.intern); e.setAttribute('aria-checked', S.intern); const c = document.getElementById('cInt'); if (S.intern) c.classList.add('vis'); else { c.classList.remove('vis'); document.getElementById('lFI').value = ''; document.getElementById('lSal').value = ''; } }
        function updVis() { const a = S.tipo === 'atendible'; document.getElementById('sTer').classList.toggle('hid', !a); document.getElementById('lnTer').classList.toggle('hid', !a); updStep(); updProg(); }

        /* ═══ DEPENDENCIA → JEFE ═══ */
        function onDep() { const id = parseInt(document.getElementById('sDep').value); const b = document.getElementById('jBox'); if (!id) { b.style.display = 'none'; S.jefe = null; return; } const d = DEPS.find(x => x.id === id); if (d) { S.jefe = d; document.getElementById('jNm').textContent = d.jefe; document.getElementById('jDp').textContent = d.nombre + ' — ' + d.email; b.style.display = 'flex'; } }

        /* ═══ NAVEGACION ═══ */
        function isAtt() { return S.tipo === 'atendible'; }
        function next(f) { if (!val(f)) return; let n = f + 1; if (f === 2 && !isAtt()) n = 4; go(n); }
        function prev(f) { let p = f - 1; if (f === 4 && !isAtt()) p = 2; go(p); }
        function go(s) { document.getElementById('p' + S.cur).classList.remove('act'); S.cur = s; document.getElementById('p' + s).classList.add('act'); updProg(); updStep(); updBot(); if (s === 6) genSum(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
        function goD(s) { document.getElementById('p' + S.cur).classList.remove('act'); S.cur = s; document.getElementById('p' + s).classList.add('act'); updProg(); updStep(); updBot(); window.scrollTo({ top: 0, behavior: 'smooth' }); }

        function updProg() { const tot = isAtt() ? 6 : 5; const rn = gRN(S.cur); document.getElementById('pF').style.width = Math.round(rn / tot * 100) + '%'; document.getElementById('pT').textContent = rn + ' / ' + tot; const info = SL[S.cur]; document.getElementById('pS').innerHTML = '<i class="fas ' + info.i + '"></i> ' + info.l; }
        function gRN(s) { let n = 0; for (let i = 1; i <= s; i++) { const e = document.querySelector('.st-i[data-step="' + i + '"]'); if (!e.classList.contains('hid')) n++; } return n; }

        function updStep() {
            document.querySelectorAll('.st-i').forEach(e => { const s = +e.dataset.step; e.classList.remove('act', 'done'); if (e.classList.contains('hid')) return; if (s === S.cur) { e.classList.add('act'); e.querySelector('.st-c').textContent = gRN(s); } else if (s < S.cur) { e.classList.add('done'); e.querySelector('.st-c').innerHTML = '<i class="fas fa-check"></i>'; } else { e.querySelector('.st-c').textContent = gRN(s); } });
            document.querySelectorAll('.st-ln').forEach(l => { const n = +l.dataset.line; l.classList.remove('done'); if (l.classList.contains('hid')) return; if (n < S.cur) l.classList.add('done'); });
        }

        function updBot() { const bp = document.getElementById('bPrev'), bn = document.getElementById('bNext'), bs = document.getElementById('bSub'); bp.style.display = S.cur > 1 ? 'flex' : 'none'; if (S.cur === 6) { bn.style.display = 'none'; bs.style.display = 'flex'; } else { bn.style.display = 'flex'; bs.style.display = 'none'; } }

        /* ═══ VALIDACIONES ═══ */
        function clrE() { document.querySelectorAll('.em').forEach(e => e.classList.remove('vis')); document.querySelectorAll('.err').forEach(e => e.classList.remove('err')); }
        function sE(iid, eid) { const i = document.getElementById(iid); const e = document.getElementById(eid); if (i) i.classList.add('err'); if (e) e.classList.add('vis'); }
        function val(s) {
            clrE(); let o = true;
            if (s === 1) { if (!document.getElementById('sMotivo').value) { sE('sMotivo', 'eMotivo'); o = false; } if (S.nat === 'prolongacion' && !document.getElementById('nroLicAnt').value.trim()) { sE('nroLicAnt', 'eNroL'); o = false; } }
            if (s === 2) { if (!document.getElementById('sLeg').value.trim()) sE('sLeg', 'eLeg'), o = false; if (!document.getElementById('sGra').value) sE('sGra', 'eGra'), o = false; if (!document.getElementById('sDni').value.trim()) sE('sDni', 'eDni'), o = false; if (!document.getElementById('sNom').value.trim()) sE('sNom', 'eNom'), o = false; if (!document.getElementById('sFN').value) sE('sFN', 'eFN'), o = false; if (!document.getElementById('sTel').value.trim()) sE('sTel', 'eTel'), o = false; if (!document.getElementById('sEma').value.trim()) sE('sEma', 'eEma'), o = false; if (!document.getElementById('sDir').value.trim()) sE('sDir', 'eDir'), o = false; if (!document.getElementById('sUsu').value.trim()) sE('sUsu', 'eUsu'), o = false; if (!document.getElementById('sOS').value.trim()) sE('sOS', 'eOS'), o = false; if (!document.getElementById('sDep').value) sE('sDep', 'eDep'), o = false; }
            if (s === 3) { if (!document.getElementById('tVin').value) sE('tVin', 'eTV'), o = false; if (!document.getElementById('tNom').value.trim()) sE('tNom', 'eTN'), o = false; if (!document.getElementById('tDni').value.trim()) sE('tDni', 'eTD'), o = false; if (!document.getElementById('tDiag').value.trim()) sE('tDiag', 'eTDi'), o = false; }
            if (s === 4) { if (!document.getElementById('lDes').value) sE('lDes', 'eDes'), o = false; if (!document.getElementById('lHas').value) sE('lHas', 'eHas'), o = false; const d = document.getElementById('lDes').value, h = document.getElementById('lHas').value; if (d && h && h < d) { sE('lHas', 'eHas'); document.getElementById('eHas').innerHTML = '<i class="fas fa-exclamation-circle"></i> Debe ser posterior'; o = false; } if (!document.getElementById('lCie').value.trim()) sE('lCie', 'eCie'), o = false; if (document.getElementById('lEsp').value === 'Otra' && !document.getElementById('lEspOtra').value.trim()) sE('lEspOtra', 'eEspOtra'), o = false; }
            if (s === 5) { if (!S.arch.cert.length) { toast('Subí al menos el certificado médico', 'er'); o = false; } }
            if (!o) toast('Completá los campos obligatorios', 'er'); return o;
        }

        /* ═══ UPLOAD ═══ */
        const MX = 10 * 1024 * 1024, ALW = ['application/pdf', 'image/jpeg', 'image/jpg', 'image/png'];
        function dO(e, z) { e.preventDefault(); document.getElementById(z).classList.add('dov'); }
        function dL(e, z) { e.preventDefault(); document.getElementById(z).classList.remove('dov'); }
        function dD(e, c) { e.preventDefault(); const z = 'z' + c.charAt(0).toUpperCase() + c.slice(1); document.getElementById(z).classList.remove('dov'); pF(e.dataTransfer.files, c); }
        function fS(e, c) { pF(e.target.files, c); e.target.value = ''; }
        function pF(files, cat) { let a = 0; for (const f of files) { if (!ALW.includes(f.type)) { toast('"' + f.name + '" formato no válido', 'er'); continue; } if (f.size > MX) { toast('"' + f.name + '" supera 10MB', 'er'); continue; } if (S.arch[cat].some(x => x.name === f.name && x.size === f.size)) { toast('"' + f.name + '" ya cargado', 'in'); continue; } S.arch[cat].push({ name: f.name, size: f.size, type: f.type, file: f }); a++; } if (a) { rF(cat); toast(a + ' archivo(s) cargado(s)', 'ok'); } }
        function rmF(c, i) { S.arch[c].splice(i, 1); rF(c); }
        function rF(cat) { const m = { cert: 'lC', est: 'lE', rec: 'lR' }; const l = document.getElementById(m[cat]); l.innerHTML = ''; S.arch[cat].forEach((f, i) => { const ext = f.name.split('.').pop().toUpperCase(); const ic = ext === 'PDF' ? 'fa-file-pdf' : 'fa-file-image'; l.innerHTML += `<div class="fl-i"><div class="fi-ic"><i class="fas ${ic}"></i></div><div class="fi-n"><div class="fi-nm">${esc(f.name)}</div><div class="fi-sz">${fSz(f.size)}</div></div><button class="fi-rm" onclick="rmF('${cat}',${i})" aria-label="Eliminar"><i class="fas fa-times"></i></button></div>`; }); }
        function fSz(b) { return b < 1024 ? b + ' B' : b < 1048576 ? (b / 1024).toFixed(1) + ' KB' : (b / 1048576).toFixed(1) + ' MB'; }
        function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

        /* ═══ RESUMEN ═══ */
        function genSum() {
            const c = document.getElementById('sumC'); let h = '';
            const motText = S.motivo || 'No informado';
            const tb = S.tipo === 'propia' ? '<span class="badge gn"><i class="fas fa-user"></i> Propia</span>' : '<span class="badge am"><i class="fas fa-people-arrows"></i> Atendible</span>';
            const nb = S.nat === 'nueva' ? '<span class="badge gn"><i class="fas fa-file-medical"></i> Nueva</span>' : '<span class="badge am"><i class="fas fa-file-circle-plus"></i> Prolongación</span>';
            h += `<div class="ss"><div class="ss-h" onclick="goD(1)"><h4><i class="fas fa-clipboard-list"></i> Tipo y Motivo</h4><button class="eb"><i class="fas fa-pen"></i> Editar</button></div><div class="ss-b"><div class="ss-g"><div class="sf fu"><span class="sl">Motivo</span><span class="sv">${esc(motText)}</span></div><div class="sf"><span class="sl">Tipo</span><span class="sv">${tb}</span></div><div class="sf"><span class="sl">Naturaleza</span><span class="sv">${nb}</span></div>${S.nat === 'prolongacion' ? `<div class="sf fu"><span class="sl">Lic. Anterior</span><span class="sv">${v('nroLicAnt')}</span></div>` : ''}</div></div></div>`;
            const dep = DEPS.find(d => d.id === +v('sDep'));
            h += `<div class="ss"><div class="ss-h" onclick="goD(2)"><h4><i class="fas fa-id-badge"></i> Personal</h4><button class="eb"><i class="fas fa-pen"></i> Editar</button></div><div class="ss-b"><div class="ss-g"><div class="sf"><span class="sl">Legajo</span><span class="sv">${v('sLeg')}</span></div><div class="sf"><span class="sl">Jerarquía</span><span class="sv">${v('sGra')}</span></div><div class="sf"><span class="sl">DNI</span><span class="sv">${v('sDni')}</span></div><div class="sf"><span class="sl">CUIL</span><span class="sv">${v('sCui') || emp()}</span></div><div class="sf fu"><span class="sl">Nombre</span><span class="sv">${v('sNom')}</span></div><div class="sf"><span class="sl">Fec. Nac.</span><span class="sv">${fD(v('sFN'))}</span></div><div class="sf"><span class="sl">Teléfono</span><span class="sv">${v('sTel')}</span></div><div class="sf"><span class="sl">Email</span><span class="sv">${v('sEma')}</span></div><div class="sf fu"><span class="sl">Dom. Real</span><span class="sv">${v('sDir') || emp()}</span></div><div class="sf fu"><span class="sl">Lugar Usufructo</span><span class="sv">${v('sUsu') || emp()}</span></div><div class="sf"><span class="sl">Obra Social</span><span class="sv">${v('sOS')}</span></div><div class="sf fu"><span class="sl">Dependencia</span><span class="sv">${dep ? dep.nombre : emp()}</span></div><div class="sf fu"><span class="sl">Jefe a Notificar</span><span class="sv" style="color:var(--gold)">${dep ? dep.jefe + ' (' + dep.email + ')' : emp()}</span></div></div></div></div>`;
            if (isAtt()) { h += `<div class="ss"><div class="ss-h" onclick="goD(3)"><h4><i class="fas fa-people-arrows"></i> Tercero</h4><button class="eb"><i class="fas fa-pen"></i> Editar</button></div><div class="ss-b"><div class="ss-g"><div class="sf"><span class="sl">Vínculo</span><span class="sv">${v('tVin')}</span></div><div class="sf"><span class="sl">DNI</span><span class="sv">${v('tDni')}</span></div><div class="sf fu"><span class="sl">Nombre</span><span class="sv">${v('tNom')}</span></div><div class="sf fu"><span class="sl">Diagnóstico</span><span class="sv">${v('tDiag')}</span></div></div></div></div>`; }
            const espDisp = v('lEsp') === 'Otra' ? ('Otra' + (v('lEspOtra') ? ' (' + v('lEspOtra') + ')' : '')) : (v('lEsp') || emp());
            h += `<div class="ss"><div class="ss-h" onclick="goD(4)"><h4><i class="fas fa-notes-medical"></i> Detalle</h4><button class="eb"><i class="fas fa-pen"></i> Editar</button></div><div class="ss-b"><div class="ss-g"><div class="sf"><span class="sl">Desde</span><span class="sv">${fD(v('lDes'))}</span></div><div class="sf"><span class="sl">Hasta</span><span class="sv">${fD(v('lHas'))}</span></div><div class="sf fu"><span class="sl">CIE-10</span><span class="sv">${v('lCie')}</span></div><div class="sf fu"><span class="sl">Médico</span><span class="sv">${v('lMed') || emp()}</span></div><div class="sf"><span class="sl">Especialidad</span><span class="sv">${espDisp}</span></div><div class="sf"><span class="sl">Matrícula</span><span class="sv">${v('lMat') || emp()}</span></div><div class="sf"><span class="sl">Institución</span><span class="sv">${v('lIns') || emp()}</span></div><div class="sf"><span class="sl">Tel. Médico</span><span class="sv">${v('lTM') || emp()}</span></div><div class="sf fu"><span class="sl">Internación</span><span class="sv">${S.intern ? 'Sí' : 'No'}</span></div>${S.intern ? `<div class="sf"><span class="sl">Fec. Ingreso</span><span class="sv">${fD(v('lFI')) || emp()}</span></div><div class="sf"><span class="sl">Sala</span><span class="sv">${v('lSal') || emp()}</span></div>` : ''}</div></div></div>`;
            const af = [...S.arch.cert.map(f => ({ ...f, c: 'Cert' })), ...S.arch.est.map(f => ({ ...f, c: 'Estudio' })), ...S.arch.rec.map(f => ({ ...f, c: 'Receta' }))];
            h += `<div class="ss"><div class="ss-h" onclick="goD(5)"><h4><i class="fas fa-paperclip"></i> Docs (${af.length})</h4><button class="eb"><i class="fas fa-pen"></i> Editar</button></div>`; if (af.length) h += `<div class="ss-b"><div class="ss-fl">${af.map(f => `<span class="ss-ft"><i class="fas fa-file"></i> ${esc(f.name)} (${f.c})</span>`).join('')}</div></div>`; else h += `<div class="ss-b"><div class="ss-g"><div class="sf fu"><span class="sv empty">Sin archivos</span></div></div></div>`; h += '</div>';
            c.innerHTML = h;
        }
        function v(id) { const e = document.getElementById(id); return e ? e.value.trim() : ''; }
        function fD(s) { if (!s) return ''; const p = s.split('-'); return p.length === 3 ? p[2] + '/' + p[1] + '/' + p[0] : s; }
        function emp() { return '<span class="empty">No informado</span>'; }

        /* ═══ ENVIO ═══ */
        function doSubmit() { const y = new Date().getFullYear(); const r = String(Math.floor(Math.random() * 99999) + 1).padStart(5, '0'); document.getElementById('trNum').textContent = 'LM-' + y + '-' + r; document.getElementById('modOk').classList.add('vis'); toast('Solicitud enviada con éxito', 'ok'); }
        function resetApp() { document.getElementById('modOk').classList.remove('vis'); S.cur = 1; S.tipo = 'propia'; S.motivo = ''; S.nat = 'nueva'; S.intern = false; S.jefe = null; S.arch = { cert: [], est: [], rec: [] }; setNat('nueva'); document.getElementById('chkI').classList.remove('ck'); document.getElementById('cProl').classList.remove('vis'); document.getElementById('cInt').classList.remove('vis'); document.getElementById('cEspOtra').classList.remove('vis'); document.getElementById('jBox').style.display = 'none'; document.querySelectorAll('input:not([type="file"]),select,textarea').forEach(e => e.value = ''); rF('cert'); rF('est'); rF('rec'); clrE(); document.querySelectorAll('.panel').forEach(p => p.classList.remove('act')); document.getElementById('p1').classList.add('act'); updVis(); updProg(); updStep(); updBot(); window.scrollTo({ top: 0, behavior: 'smooth' }); }

        /* ═══ TOASTS ═══ */
        function toast(msg, type) { const c = document.getElementById('toastC'); const ic = { ok: 'fa-check-circle', er: 'fa-exclamation-triangle', in: 'fa-info-circle' }; const t = document.createElement('div'); t.className = 'toast ' + type; t.innerHTML = '<i class="fas ' + (ic[type] || ic.in) + '"></i> ' + msg; c.appendChild(t); setTimeout(() => { t.style.animation = 'tO .3s ease forwards'; setTimeout(() => t.remove(), 300); }, 3500); }


        /* Teclado */
        document.querySelectorAll('[role="switch"],[role="checkbox"],[role="radio"]').forEach(el => { el.addEventListener('keydown', e => { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); el.click(); } }); });
    </script>
</body>

</html>