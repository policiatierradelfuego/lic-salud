        let CURRENT_USER = null;

        // Base de datos simulada para demostración
        const MOCK_USERS = {
            "12345": {
                legajo: "12345",
                grado: "Principal",
                nombre: "Pérez, Juan Carlos",
                dni: "35123456",
                cuil: "20-35123456-8",
